{
    "name": "synergitech/laravel-typescript-generator",
    "description": "Generate TypeScript type definitions from Laravel Eloquent models via schema introspection and model metadata.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "SynergiTech\\TypeScriptGenerator\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SynergiTech\\TypeScriptGenerator\\TypeScriptGeneratorServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "SynergiTech\\TypeScriptGenerator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-text"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    }
}

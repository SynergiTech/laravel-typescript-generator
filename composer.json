{
    "name": "synergitech/laravel-typescript-generator",
    "description": "Generate TypeScript type definitions from Laravel Eloquent models via schema introspection and model metadata.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "SynergiTech\\TypeScriptGenerator\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SynergiTech\\TypeScriptGenerator\\TypeScriptGeneratorServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0"
    }
}
